[Unit]
Description=Peztz YOLO dog detection dashboard
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service peztz-camera.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/peztz-ai
EnvironmentFile=/etc/peztz/camera-stream.env
ExecStart=/home/admin/peztz-ai/venv/bin/python /home/admin/peztz-ai/yolo_dashboard.py --bind 100.78.197.87 --port 8090 --imgsz 640 --conf 0.50
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
